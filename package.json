{
  "name": "@bozonx/ai-kit",
  "version": "0.3.0",
  "description": "Reusable core for building AI features: priced model catalog, model policy, provider adapters, retries, tools, embeddings and prompt assembly",
  "type": "module",
  "license": "MIT",
  "author": "Ivan K",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bozonx/ai-kit.git"
  },
  "bugs": {
    "url": "https://github.com/bozonx/ai-kit/issues"
  },
  "homepage": "https://github.com/bozonx/ai-kit",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stt": {
      "types": "./dist/stt/index.d.ts",
      "import": "./dist/stt/index.js"
    },
    "./translate": {
      "types": "./dist/translate/index.d.ts",
      "import": "./dist/translate/index.js"
    },
    "./stream": {
      "types": "./dist/stream/index.d.ts",
      "import": "./dist/stream/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "models.example.yaml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "test:cov": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test",
    "prepack": "pnpm run clean && pnpm run build",
    "prepublishOnly": "pnpm run check"
  },
  "dependencies": {
    "ai": "^7.0.84",
    "js-yaml": "^5.3.0"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.46",
    "@ai-sdk/google": "^4.0.76",
    "@ai-sdk/openai": "^4.0.71",
    "@eslint/js": "^9.39.2",
    "@jest/globals": "^30.2.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.8",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.12.1",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.2.0",
    "prettier": "^3.7.4",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.25.0",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "peerDependencies": {
    "@ai-sdk/anthropic": "^4.0.46",
    "@ai-sdk/google": "^4.0.76",
    "@ai-sdk/openai": "^4.0.71",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ws": "^8.21.3",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "@openrouter/ai-sdk-provider": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  }
}
